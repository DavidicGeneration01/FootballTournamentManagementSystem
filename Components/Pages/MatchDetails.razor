@page "/matches/{Id:int}"
@rendermode InteractiveServer
@using FootballTournamentManagementSystem.Data
@using FootballTournamentManagementSystem.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject ICurrentUserDbContextFactory DbFactory
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Match Details</PageTitle>

@if (Saved == "1")
{
    <p class="panel-muted">Changes saved.</p>
}

@if (isLoading)
{
    <p>Loading match details...</p>
}
else if (errorMessage is not null)
{
    <section class="empty-state"><h2>Unable to load match</h2><p>@errorMessage</p><a class="btn btn-secondary" href="/matches">Back to matches</a></section>
}
else if (match is null)
{
    <section class="empty-state">
        <h2>Match not found</h2>
        <p>No match exists with that ID.</p>
        <a class="btn btn-secondary" href="/matches">Back to matches</a>
    </section>
}
else
{
    <div class="page-heading">
        <div>
            <p class="eyebrow">Fixture</p>
            <h1 class="page-title">@match.HomeTeam.Name vs @match.AwayTeam.Name</h1>
            <p class="page-subtitle">@match.Tournament.Name · @match.MatchDate.ToString("MMM d, yyyy") · @match.Location</p>
            <p class="panel-muted">Created by @match.CreatedByUser.FullName · @match.CreatedAt.ToLocalTime().ToString("g")</p>
            @if (match.UpdatedAt.HasValue)
            {
                <p class="panel-muted">Updated by @match.UpdatedByUser?.FullName · @match.UpdatedAt.Value.ToLocalTime().ToString("g")</p>
            }
        </div>
        <a class="btn btn-secondary" href="/matches">Back to matches</a>
    </div>

    <section class="standings-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">Score</p>
                <h2>@match.HomeScore - @match.AwayScore</h2>
            </div>
            <span class="status-badge status-@match.Status.ToString().ToLowerInvariant()">@match.Status</span>
        </div>

        <div class="match-scoreline">
            <strong>@match.HomeTeam.Name</strong>
            <span>@match.HomeScore - @match.AwayScore</span>
            <strong>@match.AwayTeam.Name</strong>
        </div>
    </section>

    <section class="standings-panel">
        <div class="panel-heading">
            <div>
                <p class="eyebrow">Match events</p>
                <h2>Event log</h2>
            </div>
            @if (CanManage(match))
            {
                <a class="btn btn-primary" href="/match-events/create/@Id">Record event</a>
            }
        </div>

        @if (events.Count == 0)
        {
            <p class="panel-muted">No events have been recorded for this fixture yet.</p>
        }
        else
        {
            <div class="event-list">
                @foreach (var matchEvent in events.OrderBy(item => item.Minute ?? 121))
                {
                    <div class="event-row">
                        <span class="event-minute">@(matchEvent.Minute is null ? "-" : $"{matchEvent.Minute}'")</span>
                        <strong>@matchEvent.EventType</strong>
                        <span>@matchEvent.GoalScorer.FirstName @matchEvent.GoalScorer.LastName</span>
                        <span>Created by @matchEvent.CreatedByUser.FullName · @matchEvent.CreatedAt.ToLocalTime().ToString("g")</span>
                        @if (matchEvent.AssistedByPlayer is not null)
                        {
                            <span>Assist: @matchEvent.AssistedByPlayer.FirstName @matchEvent.AssistedByPlayer.LastName</span>
                        }
                        @if (CanManage(matchEvent))
                        {
                                <a href="/matches/@Id/events/edit/@matchEvent.Id">Edit</a>
                                <a href="/matches/@Id/events/delete/@matchEvent.Id">Delete</a>
                        }
                    </div>
                }
            </div>
        }
    </section>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")]
    public string? Saved { get; set; }

    [Parameter]
    public int Id { get; set; }

    private Match? match;
    private List<MatchEvent> events = new();
    private string? errorMessage;
    private bool isLoading = true;
    private string? currentUserId;
    private bool isAdmin;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var user = (await AuthenticationStateProvider.GetAuthenticationStateAsync()).User;
            currentUserId = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
            isAdmin = user.IsInRole("Admin");
            await using var db = await DbFactory.CreateDbContextAsync();
            match = await db.Matches
                .AsNoTracking()
                .Include(item => item.Tournament)
                .Include(item => item.HomeTeam)
                .Include(item => item.AwayTeam)
                .Include(item => item.CreatedByUser)
                .Include(item => item.UpdatedByUser)
                .SingleOrDefaultAsync(item => item.Id == Id);

            if (match is not null)
            {
                events = await db.MatchEvents
                    .AsNoTracking()
                    .Include(item => item.GoalScorer)
                    .Include(item => item.AssistedByPlayer)
                    .Include(item => item.CreatedByUser)
                    .Include(item => item.UpdatedByUser)
                    .Where(item => item.MatchId == Id)
                    .OrderBy(item => item.Minute ?? 121)
                    .ToListAsync();
            }
        }
        catch
        {
            errorMessage = "Please try again later.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool CanManage(IOwnedRecord record) => isAdmin || record.CreatedByUserId == currentUserId;
}
